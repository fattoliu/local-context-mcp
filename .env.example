# Local HTTP endpoint
LOCAL_CONTEXT_HOST=127.0.0.1
LOCAL_CONTEXT_PORT=7331

# Allowed local roots. Separate multiple paths with ':' on macOS/Linux.
# Example: ~/.claude/projects:/Users/fatto/Desktop
LOCAL_CONTEXT_ROOTS=~/.claude/projects

# Claude Code history root
CLAUDE_PROJECTS_ROOT=~/.claude/projects

# Safety / response limits
LOCAL_CONTEXT_MAX_READ_BYTES=524288
LOCAL_CONTEXT_MAX_SEARCH_RESULTS=100
